# Market Visual Operator Surface v1 — LOCAL example env (read-only, non-authorizing).
#
# These gates are fail-closed OFF by default in app code. This example is only for local
# operator inspection of the /market dashboard against offline evidence bundles. It grants
# NO runtime, order, live, promotion or execution authority.
#
# Copy/edit values or use scripts/ops/start_market_dashboard_visual_operator_readonly_v1.sh
# which materializes bundles and exports these automatically.

# Offline futures OHLCV read-model (materialized from historical panel; timeframe 1h).
PEAK_TRADE_MARKET_FUTURES_OHLCV_ENABLED=1
PEAK_TRADE_MARKET_FUTURES_OHLCV_BUNDLE_ROOT=/tmp/peak_trade_market_visual_operator_bundles_v1/futures_ohlcv

# Offline governed ranking funnel read-model (display-only, volume-ranked, no Bitcoin).
PEAK_TRADE_MARKET_RANKING_FUNNEL_ENABLED=1
PEAK_TRADE_MARKET_RANKING_FUNNEL_BUNDLE_ROOT=/tmp/peak_trade_market_visual_operator_bundles_v1/ranking_funnel

# Offline F5 futures read-only dashboard read-model (partial instrument metadata).
PEAK_TRADE_F5_MARKET_DASHBOARD_ENABLED=1
PEAK_TRADE_F5_MARKET_DASHBOARD_BUNDLE_ROOT=/tmp/peak_trade_market_visual_operator_bundles_v1/f5_dashboard

# Visual operator economic evidence root (dir with economic_evidence_binding.json OR the
# PR5242 offline economic evidence dir itself). Read-only; no metrics are invented.
PEAK_TRADE_MARKET_VISUAL_OPERATOR_EVIDENCE_ROOT=/tmp/peak_trade_market_visual_operator_bundles_v1

# Optional linear diagnostics evidence dir (read-only parse; compact-empty if unset).
PEAK_TRADE_MARKET_LINEAR_DIAGNOSTICS_BUNDLE_ROOT=/Users/frnkhrz/Documents/Peak_Trade_runtime_evidence_archive_20260520T161443Z/research/bouchaud_microstructure_ohlcv_proxy_v1_offline_productive_linear_diagnostics_execution_and_support_evidence_v0_20260715T004424Z

# Keep unrelated request-time data providers off (no spot/synthetic fallback).
PEAK_TRADE_MARKET_DEPTH_ENABLED=0
