{
  "digest_model": {
    "algorithm": "SHA-256",
    "canonical_serialization": "JSON Canonical Form (JCS/RFC 8785 style): UTF-8, sorted object keys, no insignificant whitespace",
    "excluded_volatile_fields": [
      "created_at_utc",
      "runner_host",
      "process_id"
    ],
    "null_handling": "Required fields must not be null; optional absent vs null explicit in schema",
    "numeric_normalization": "Decimals as strings fixed-scale per metric_schema; integers as JSON numbers",
    "ordering": "Arrays: contract-defined order; objects: key-sorted",
    "protected_domains": [
      "ranking_universe",
      "selection",
      "mv2",
      "dp",
      "confirmation",
      "sidestate",
      "entry_exit",
      "scope",
      "crs",
      "sizing",
      "admission",
      "venue_plan"
    ],
    "schema_version_binding": "digest includes schema_version field inside payload",
    "timestamp_handling": "UTC ISO8601 with Z; excluded from digest if volatile (e.g. created_at) when listed in excluded_fields",
    "verdicts": {
      "DIGEST_CHANGED_EXPECTED": "authorized slice declared expected change",
      "DIGEST_CHANGED_UNEXPECTED": "fail-closed; WHOLE_SYSTEM_REPROOF via resolver",
      "DIGEST_CONFLICTING": "CURRENT_CONFLICT; STOP",
      "DIGEST_EQUAL": "baseline and candidate digests match",
      "DIGEST_UNAVAILABLE": "fail-closed unless contract allows absent"
    }
  },
