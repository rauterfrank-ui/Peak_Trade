+
+def test_04b_in_memory_validation_is_fail_closed_without_expected_code(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.delenv(DEFAULT_APPROVAL_CODE_ENV, raising=False)
