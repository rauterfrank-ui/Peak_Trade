+    "parse_naive_utc",
+    "requested_event_fields",
+    "resolve_approval_secret",
+    "sign_fields",
+    "verify_active_attestation",
+    "verify_active_attestation_from_env",
+    "verify_fields",
+    "verify_pending_request_binding",
+]
